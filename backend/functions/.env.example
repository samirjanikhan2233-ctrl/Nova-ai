# Copy to .env (non-secret config). The AI key is a SECRET: firebase functions:secrets:set ANTHROPIC_API_KEY
PACKAGE_NAME=com.muhammdsamirkabirkhan.novaai
PREMIUM_PRODUCT_ID=nova_premium
FREE_DAILY_LIMIT=15
PREMIUM_DAILY_LIMIT=300
MODEL_FREE=claude-haiku-4-5-20251001
MODEL_PREMIUM=claude-sonnet-5
MAX_REWARDS_PER_DAY=5
# Turn on AFTER registering Play Integrity in Firebase App Check (see docs/PUBLISHING_GUIDE.md)
ENFORCE_APP_CHECK=false
